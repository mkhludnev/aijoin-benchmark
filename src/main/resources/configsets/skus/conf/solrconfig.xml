<?xml version="1.0" ?>
<config>
  <schemaFactory class="ClassicIndexSchemaFactory"/>

  <luceneMatchVersion>LATEST</luceneMatchVersion>

  <dataDir>${solr.data.dir:}</dataDir>

  <!-- The "from" side of the aux-index join. Every per-from-segment cost the join carries scales
       with the segment's maxDoc: the from-side docset bitset, the from-ord map, and the sidecar
       batch, which writes one document per from-doc whatever the pair matched. Nothing here shrinks
       the ~5M-doc segments this index already has; the cap keeps them from merging into one ~10M-doc
       segment and doubling all of it. At this index's ~40 bytes/doc, 200MB lands near 5M docs --
       re-check that ratio if the schema changes, since Tiered has no doc-count knob. -->
  <indexConfig>
    <mergePolicyFactory class="org.apache.solr.index.TieredMergePolicyFactory">
      <double name="maxMergedSegmentMB">200.0</double>
    </mergePolicyFactory>
  </indexConfig>

  <updateHandler class="solr.DirectUpdateHandler2">
    <updateLog/>
    <autoCommit>
      <maxTime>60000</maxTime>
      <openSearcher>false</openSearcher>
    </autoCommit>
  </updateHandler>

  <requestHandler name="/select" class="solr.SearchHandler"/>
  <queryParser name="aijoin" class="org.apache.solr.search.join.AuxIndexJoinQParserPlugin"/>
</config>
